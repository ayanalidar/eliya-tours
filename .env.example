# ---------- Database ----------
# LOCAL DEV (SQLite):
# DATABASE_URL="file:./db/custom.db"
#
# PRODUCTION (Supabase Postgres) — use the POOLER URL (port 6543), NOT the direct URL:
# Get from: Supabase dashboard → Settings → Database → Connection string → "Transaction" mode
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# IMPORTANT: URL-encode any special chars in password (@ → %40, # → %23, etc.)
#
# For this project (replace [REGION] with your Supabase project's region — check Supabase dashboard):
DATABASE_URL="postgresql://postgres.ssndwdauxdwwvfnafiuh:Ayanalidar%40110@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# ---------- z-ai-web-dev-sdk (AI Guide) ----------
# Used by /api/chat for the Tariq AI guide
ZAI_API_KEY="fe6e56c1437a4ce9883a6646dbd6fa74.qLbw0dh0gaR2042W"

# ---------- Vercel Blob (image uploads) ----------
# Optional but recommended for production image uploads
# Create at: https://vercel.com/dashboard/stores → New Store → Blob
BLOB_READ_WRITE_TOKEN=""

# ---------- Admin session secret ----------
# Any random string — used to sign admin session cookies
ELIYA_SESSION_SECRET="change-this-to-a-random-string-in-production"

