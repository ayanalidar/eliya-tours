# ============================================================
# Eliya Tours And Travels — Environment Variables
# Copy this file to .env (local) or set in Vercel dashboard
# ============================================================

# ---------- Database ----------
# LOCAL DEV (SQLite):
# DATABASE_URL="file:./db/custom.db"
#
# VERCEL PRODUCTION (Vercel Postgres — auto-provisioned):
# Create at: https://vercel.com/dashboard/stores → New Store → Postgres
# Then add the connection string here:
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# ---------- z-ai-web-dev-sdk (AI Guide) ----------
# Used by /api/chat for the Tariq AI guide
# Get from: https://z.ai (or your z-ai dashboard)
ZAI_API_KEY=""

# ---------- Vercel Blob (image uploads) ----------
# Optional but recommended for production image uploads
# Create at: https://vercel.com/dashboard/stores → New Store → Blob
BLOB_READ_WRITE_TOKEN=""

# ---------- Admin session secret ----------
# Any random string — used to sign admin session cookies
ELIYA_SESSION_SECRET="change-this-to-a-random-string-in-production"

# ---------- NextAuth (if using) ----------
# NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
# NEXTAUTH_URL="http://localhost:3000"

# ---------- WhatsApp Business API (optional) ----------
# For the WhatsApp bot integration
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""

# ---------- Email (optional) ----------
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
